# Database URL (SQLite for local zero-config, or postgresql://user:pass@host:5432/db for production)
DATABASE_URL="file:./dev.db"

# Google Drive Target Folder ID to Sync and Upload into
GOOGLE_DRIVE_FOLDER_ID=""

# Option 1: Google Cloud Service Account Credentials (JSON string or Base64 encoded JSON)
# Example: GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'
GOOGLE_SERVICE_ACCOUNT_KEY=""

# Option 2: Google OAuth2 Credentials (Alternative to Service Account)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
